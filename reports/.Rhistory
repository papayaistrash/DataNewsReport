subtitle = "廠工代扣以「所得稅」與「儲蓄金」為主；看護工高達 82.6% 被代扣「國外貸款」",
x = "占有代扣費用移工之比例 (複選 %)", y = NULL, fill = "移工類別"
) +
theme(legend.position = "right")
knitr::opts_chunk$set(
echo = TRUE, message = FALSE, warning = FALSE,
fig.width = 11, fig.height = 9, dpi = 150,
fig.showtext = TRUE
)
library(tidyverse)
library(haven)
library(knitr)
# 動態判斷路徑，確保不論在何處編譯均能讀取
root_dir <- getwd()
if (basename(root_dir) == "reports") {
data_path <- "../data/113年移工/事業面/data113.sav"
} else {
data_path <- "data/113年移工/事業面/data113.sav"
}
biz_sav <- read_sav(data_path)
comparison_tbl <- biz_sav %>%
mutate(
runaway = ifelse(q4 == 2, 1, 0),
scale_name = as_factor(scale)
) %>%
filter(!is.na(runaway), !is.na(scale_name)) %>%
group_by(scale_name) %>%
summarise(
n = n(),
w1_rate = sum(w1[runaway == 1], na.rm = TRUE) / sum(w1, na.rm = TRUE) * 100,
w3_rate = sum(w3[runaway == 1], na.rm = TRUE) / sum(w3, na.rm = TRUE) * 100,
.groups = "drop"
)
comparison_tbl %>%
mutate(
w1_rate = paste0(round(w1_rate, 2), " %"),
w3_rate = paste0(round(w3_rate, 2), " %"),
n = format(n, big.mark = ",")
) %>%
kable(
col.names = c("事業單位規模", "有效樣本數 (家)", "家數加權失聯率 (w1)", "人數加權失聯率 (w3)"),
align = "c",
caption = "表1. 不同權重下之規模別失聯經驗發生率對照表"
)
library(showtext)
library(ggplot2)
library(scales)
# 註冊 Google 字型 Noto Sans TC
font_add_google("Noto Sans TC", "NotoSans")
showtext_auto()
# 1. 計算排序
ind_order <- biz_sav %>%
mutate(
runaway = ifelse(q4 == 2, 1, 0)
) %>%
filter(!is.na(runaway), !is.na(industry)) %>%
group_by(industry) %>%
summarise(
overall_rate = sum(w1[runaway == 1], na.rm = TRUE) / sum(w1, na.rm = TRUE) * 100,
.groups = "drop"
) %>%
arrange(overall_rate) %>%
mutate(ind_name = as_factor(industry)) %>%
pull(ind_name) %>%
as.character()
# 2. 準備交叉表數據
heatmap_data <- biz_sav %>%
mutate(
runaway = ifelse(q4 == 2, 1, 0),
ind_name = as.character(as_factor(industry)),
scale_name = as.character(as_factor(scale))
) %>%
filter(!is.na(runaway), !is.na(ind_name), !is.na(scale_name)) %>%
group_by(ind_name, scale_name) %>%
summarise(
n = n(),
w_total = sum(w1, na.rm = TRUE),
w_lost = sum(w1[runaway == 1], na.rm = TRUE),
.groups = "drop"
) %>%
mutate(
rate = ifelse(w_total > 0, w_lost / w_total * 100, 0),
label_text = paste0(round(rate, 1), "%\n(N=", n, ")"),
text_color = ifelse(rate > 55, "white", "#1F3145"),
ind_name = factor(ind_name, levels = ind_order),
scale_name = factor(scale_name, levels = c("1～29人", "30～99人", "100～199人", "200～499人", "500人及以上"))
)
# 3. 繪製 ggplot 熱力圖
ggplot(heatmap_data, aes(x = scale_name, y = ind_name, fill = rate)) +
geom_tile(color = "white", linewidth = 0.8) +
geom_text(aes(label = label_text, color = text_color), fontface = "bold", size = 3, lineheight = 0.9) +
scale_color_identity() +
scale_fill_gradientn(
colors = c("#FFF9F2", "#FEE8D6", "#FDBB84", "#FC8D59", "#EF6548", "#D7301F", "#990000", "#7F0000"),
values = rescale(c(0, 10, 30, 50, 70, 85, 95, 100)),
labels = function(x) paste0(x, "%"),
limits = c(0, 100)
) +
theme_minimal(base_family = "NotoSans") +
labs(
title = "我國產業移工失聯風險雙重維度熱力圖",
subtitle = "各細分行業與規模級距下「過去六年曾發生移工失聯」之加權事業單位比例 (%)",
x = "事業單位規模（員工人數）",
y = "細分行業別（依整體加權失聯率由低至高排序）",
fill = "加權失聯比例",
caption = "數據來源：勞動部 113 年移工管理及運用調查（事業面原始微觀加權數據）\n製圖說明：本圖採用家數權數 (w1) 推估；N 代表各儲存格之有效調查樣本數；排序依據為各行業之整體加權失聯發生率。"
) +
theme(
plot.title = element_text(face = "bold", size = 18, color = "#1F3145", hjust = 0, margin = margin(b = 6)),
plot.subtitle = element_text(size = 11, color = "#555555", hjust = 0, margin = margin(b = 20)),
plot.caption = element_text(size = 8.5, color = "#888888", lineheight = 1.1, margin = margin(t = 15)),
axis.title.x = element_text(face = "bold", size = 10, color = "#2c3e50", margin = margin(t = 12)),
axis.title.y = element_text(face = "bold", size = 10, color = "#2c3e50", margin = margin(r = 12)),
axis.text.x = element_text(face = "bold", size = 9, color = "#2c3e50"),
axis.text.y = element_text(face = "bold", size = 8.5, color = "#2c3e50"),
legend.position = "right",
legend.title = element_text(face = "bold", size = 9, color = "#1F3145"),
legend.text = element_text(size = 8, color = "#2c3e50"),
legend.key.height = unit(1.5, "cm"),
legend.key.width = unit(0.3, "cm"),
panel.grid = element_blank(),
plot.margin = margin(t = 20, r = 15, b = 20, l = 15)
)
knitr::opts_chunk$set(
echo = TRUE, message = FALSE, warning = FALSE,
fig.width = 11, fig.height = 8, dpi = 150,
fig.showtext = TRUE
)
library(tidyverse)
library(haven)
library(showtext)
library(ggplot2)
library(scales)
# 註冊中文字型
font_add_google("Noto Sans TC", "NotoSans")
showtext_auto()
# 1. 動態讀取路徑
root_dir <- getwd()
if (basename(root_dir) == "reports") {
biz_path <- "../data/113年移工/事業面/data113.sav"
home_path <- "../data/113年移工/家庭面/data113.sav"
} else {
biz_path <- "data/113年移工/事業面/data113.sav"
home_path <- "data/113年移工/家庭面/data113.sav"
}
biz_sav <- read_sav(biz_path)
home_sav <- read_sav(home_path)
# 2. 整理家庭面 (1人規模)
home_clean <- home_sav %>%
mutate(
runaway = ifelse(q5 == 2, 1, 0),
ind_name = "家庭看護工",
scale_name = "1人"
) %>%
filter(!is.na(runaway)) %>%
group_by(ind_name, scale_name) %>%
summarise(
n = n(),
w_total = sum(w, na.rm = TRUE),
w_lost = sum(w[runaway == 1], na.rm = TRUE),
.groups = "drop"
) %>%
mutate(
rate = w_lost / w_total * 100
)
# 3. 整理與大類分類事業面
biz_clean <- biz_sav %>%
mutate(
runaway = ifelse(q4 == 2, 1, 0),
ind_name = case_when(
industry %in% c(18, 19, 20) ~ "電子資訊與電力工業",
industry %in% c(16, 17, 21, 22, 23) ~ "金屬與機械製造業",
industry %in% c(9, 10, 11, 12, 13, 14, 15) ~ "化學與材料工業",
industry == 26 ~ "營建工程業",
industry %in% c(1, 2, 3, 4, 5, 6, 7, 8, 24, 25) ~ "民生與其他製造業",
TRUE ~ "民生與其他製造業"
),
scale_name = as.character(as_factor(scale))
) %>%
filter(!is.na(runaway), !is.na(ind_name), !is.na(scale_name)) %>%
group_by(ind_name, scale_name) %>%
summarise(
n = n(),
w_total = sum(w1, na.rm = TRUE),
w_lost = sum(w1[runaway == 1], na.rm = TRUE),
.groups = "drop"
) %>%
mutate(
rate = w_lost / w_total * 100
)
# 4. 合併並擴充矩陣
combined_data <- bind_rows(home_clean, biz_clean) %>%
mutate(
scale_name = factor(scale_name, levels = c("1人", "1～29人", "30～99人", "100～199人", "200～499人", "500人及以上"))
) %>%
complete(ind_name, scale_name)
# 5. 計算各部門整體的加權失聯經驗率，用以排序 Y 軸
overall_rates <- combined_data %>%
filter(!is.na(rate)) %>%
group_by(ind_name) %>%
summarise(
overall_rate = sum(w_lost, na.rm = TRUE) / sum(w_total, na.rm = TRUE) * 100,
.groups = "drop"
) %>%
arrange(overall_rate)
heatmap_data <- combined_data %>%
left_join(overall_rates, by = "ind_name") %>%
mutate(
ind_name = factor(ind_name, levels = overall_rates$ind_name),
label_text = case_when(
is.na(rate) ~ "－\n(不適用)",
TRUE ~ paste0(round(rate, 1), "%\n(N=", n, ")")
),
text_color = case_when(
is.na(rate) ~ "#CCCCCC",
rate > 55 ~ "white",
TRUE ~ "#1F3145"
)
)
# 6. 繪製 ggplot
ggplot(heatmap_data, aes(x = scale_name, y = ind_name, fill = rate)) +
geom_tile(color = "white", linewidth = 1.2) +
geom_text(aes(label = label_text, color = text_color), fontface = "bold", size = 3.5, lineheight = 0.95) +
scale_color_identity() +
scale_fill_gradientn(
colors = c("#FFF9F2", "#FEE8D6", "#FDBB84", "#FC8D59", "#EF6548", "#D7301F", "#990000", "#7F0000"),
values = rescale(c(0, 5, 20, 45, 65, 80, 92, 100)),
labels = function(x) paste0(x, "%"),
limits = c(0, 100),
na.value = "#F9F9F9"
) +
theme_minimal(base_family = "NotoSans") +
labs(
title = "臺灣外籍移工失聯風險雙重維度整合熱力矩陣圖",
subtitle = "家戶與事業單位在不同行業別及僱用規模下，「過去六年曾遭遇移工失聯」之加權推估比例 (%)",
x = "雇主與事業單位之移工僱用規模（員工人數）",
y = "巨觀部門與大類行業別（依總體加權失聯經驗率由低至高排序）",
fill = "加權失聯發生率",
caption = "數據來源：勞動部 113 年移工管理及運用調查（事業面原始微觀 N=4,538, 家庭面原始微觀 N=4,016 原始加權數據）\n製圖說明：本圖事業面部門採家數權數 (w1)、家庭看護採雇主權數 (w) 進行全國推估。N 為實際有效樣本數。「－(不適用)」表示該規模在該部門不符合常規或無調查樣本。"
) +
theme(
plot.title = element_text(face = "bold", size = 18, color = "#1F3145", hjust = 0, margin = margin(b = 6)),
plot.subtitle = element_text(size = 11, color = "#555555", hjust = 0, margin = margin(b = 20)),
plot.caption = element_text(size = 8.5, color = "#888888", lineheight = 1.15, margin = margin(t = 15)),
axis.title.x = element_text(face = "bold", size = 10, color = "#2c3e50", margin = margin(t = 12)),
axis.title.y = element_text(face = "bold", size = 10, color = "#2c3e50", margin = margin(r = 12)),
axis.text.x = element_text(face = "bold", size = 9, color = "#2c3e50"),
axis.text.y = element_text(face = "bold", size = 9, color = "#2c3e50"),
legend.position = "right",
legend.title = element_text(face = "bold", size = 9, color = "#1F3145"),
legend.text = element_text(size = 8, color = "#2c3e50"),
legend.key.height = unit(1.5, "cm"),
legend.key.width = unit(0.3, "cm"),
panel.grid = element_blank(),
plot.margin = margin(t = 20, r = 15, b = 20, l = 15)
)
